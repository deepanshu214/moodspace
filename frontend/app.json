{
  "expo": {
    "name": "MoodSpace",
    "slug": "moodspace",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "moodspace",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.deepanshu214.moodspace",
      "buildNumber": "1",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "MoodSpace uses your location to show nearby mood bubbles on the map and tag where you're feeling this way."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.deepanshu214.moodspace",
      "versionCode": 1,
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-image",
      "expo-secure-store",
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "MoodSpace needs access to your gallery so you can choose a personal profile picture."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "MoodSpace uses your location to show nearby mood bubbles on the map and tag where you're feeling this way."
        }
      ]
    ]
  }
}
