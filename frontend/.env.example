# Copy to .env and fill in real values. .env is gitignored — never commit real keys.
# This repository is public, so anything committed here is world-readable.

EXPO_PUBLIC_API_URL=http://localhost:8001/api/v1
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# ─── Google Maps ───
# Read by app.config.js and injected into the native build config.
# Deliberately NOT prefixed with EXPO_PUBLIC_ so they are not inlined into the
# JS bundle; they only reach AndroidManifest.xml / Info.plist where the Maps
# SDK reads them.
#
# Create both in Google Cloud Console → APIs & Services → Credentials, then
# RESTRICT each one or it can be abused and billed to your account:
#   Android key → Application restrictions → Android apps
#                 package name: com.deepanshu214.moodspace
#                 SHA-1: from `eas credentials` or `keytool -list -v -keystore ...`
#                 API restrictions → "Maps SDK for Android"
#   iOS key     → Application restrictions → iOS apps
#                 bundle ID: com.deepanshu214.moodspace
#                 API restrictions → "Maps SDK for iOS"
GOOGLE_MAPS_ANDROID_API_KEY=
GOOGLE_MAPS_IOS_API_KEY=
