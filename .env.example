# MoodSpace backend environment.
# Copy this file to .env and fill in your values. .env is gitignored.
# This repository is PUBLIC — never commit real values here.

# 1. Supabase Database Connection
# Supabase Dashboard -> Project Settings -> Database -> Connection string (URI)
# Replace [YOUR-PASSWORD] with your actual database password.
DATABASE_URL="postgresql://postgres.[your-project-id]:[YOUR-PASSWORD]@aws-0-[region].pooler.supabase.com:6543/postgres"

# 2. Security
# Generate with: openssl rand -hex 32
#
# Required — the app refuses to start without it, and rejects the old example
# key that was committed to this public repo.
#
# This signs access tokens AND derives the AES-256 key that encrypts journal
# notes and messages. Keep it STABLE across deploys: changing it logs everyone
# out and makes all previously encrypted notes and messages permanently
# unreadable. Store it in your host's secret manager, not in the image.
SECRET_KEY=""

# 3. CORS
# Comma-separated origins allowed to call the API from a browser. Native apps
# are unaffected. Leave empty in local dev and any localhost port is accepted;
# in production set it explicitly or the web build cannot reach the API.
# Example: https://moodspace.app,https://www.moodspace.app
CORS_ORIGINS=""

# 4. Uploads (optional)
# Where photos and voice notes are written. Defaults to ./media next to the
# repo. On a host with an ephemeral filesystem, point this at a mounted volume
# or uploads disappear on every redeploy.
# MEDIA_ROOT="/srv/media"

# 5. Database connect timeout in seconds (optional, defaults to a sane value).
# DB_CONNECT_TIMEOUT="10"
